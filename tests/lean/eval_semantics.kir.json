{
  "kir_version": 1,
  "kernel": "eval_semantics",
  "source": "tests/lean/eval_semantics.kir.json",
  "ir": "ttgir",
  "grid": [{"e": "const", "v": 1, "w": 32}, {"e": "const", "v": 1, "w": 32}, {"e": "const", "v": 1, "w": 32}],
  "params": [{"name": "X", "type": "i32"}],
  "tensors": [],
  "barriers": [],
  "roles": [
    {"name": "check", "warps": 1, "threads_per_issue": 1, "body": [
      {"op": "assert", "msg": "srem rounds toward zero", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "srem", "w": 32, "a": {"e": "const", "v": -7, "w": 32}, "b": {"e": "const", "v": 2, "w": 32}},
        "b": {"e": "const", "v": -1, "w": 32}}},
      {"op": "assert", "msg": "sdiv rounds toward zero", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "sdiv", "w": 32, "a": {"e": "const", "v": -7, "w": 32}, "b": {"e": "const", "v": 2, "w": 32}},
        "b": {"e": "const", "v": -3, "w": 32}}},
      {"op": "assert", "msg": "udiv is unsigned", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "udiv", "w": 32, "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 2, "w": 32}},
        "b": {"e": "const", "v": 2147483647, "w": 32}}},
      {"op": "assert", "msg": "urem is unsigned", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "urem", "w": 32, "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 16, "w": 32}},
        "b": {"e": "const", "v": 15, "w": 32}}},
      {"op": "assert", "msg": "ashr keeps the sign", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "ashr", "w": 32, "a": {"e": "const", "v": -8, "w": 32}, "b": {"e": "const", "v": 1, "w": 32}},
        "b": {"e": "const", "v": -4, "w": 32}}},
      {"op": "assert", "msg": "lshr fills zeros", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "lshr", "w": 32, "a": {"e": "const", "v": -8, "w": 32}, "b": {"e": "const", "v": 28, "w": 32}},
        "b": {"e": "const", "v": 15, "w": 32}}},
      {"op": "assert", "msg": "shl wraps into the sign bit", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "shl", "w": 32, "a": {"e": "const", "v": 1, "w": 32}, "b": {"e": "const", "v": 31, "w": 32}},
        "b": {"e": "const", "v": -2147483648, "w": 32}}},
      {"op": "assert", "msg": "shl by >= width is 0", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "shl", "w": 32, "a": {"e": "const", "v": 1, "w": 32}, "b": {"e": "const", "v": 40, "w": 32}},
        "b": {"e": "const", "v": 0, "w": 32}}},
      {"op": "assert", "msg": "ashr by >= width is the sign", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "ashr", "w": 32, "a": {"e": "const", "v": -5, "w": 32}, "b": {"e": "const", "v": 99, "w": 32}},
        "b": {"e": "const", "v": -1, "w": 32}}},
      {"op": "assert", "msg": "smin is signed", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "smin", "w": 32, "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 5, "w": 32}},
        "b": {"e": "const", "v": -1, "w": 32}}},
      {"op": "assert", "msg": "umin is unsigned", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "umin", "w": 32, "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 5, "w": 32}},
        "b": {"e": "const", "v": 5, "w": 32}}},
      {"op": "assert", "msg": "umax is unsigned", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "umax", "w": 32, "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 5, "w": 32}},
        "b": {"e": "const", "v": 4294967295, "w": 32}}},
      {"op": "assert", "msg": "and/or/xor", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "xor", "w": 32,
              "a": {"e": "bin", "o": "and", "w": 32, "a": {"e": "const", "v": 12, "w": 32}, "b": {"e": "const", "v": 10, "w": 32}},
              "b": {"e": "bin", "o": "or", "w": 32, "a": {"e": "const", "v": 12, "w": 32}, "b": {"e": "const", "v": 10, "w": 32}}},
        "b": {"e": "const", "v": 6, "w": 32}}},
      {"op": "assert", "msg": "add wraps (no addr: no overflow event)", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "bin", "o": "add", "w": 32, "a": {"e": "const", "v": 2147483647, "w": 32}, "b": {"e": "const", "v": 1, "w": 32}},
        "b": {"e": "const", "v": -2147483648, "w": 32}}},
      {"op": "assert", "msg": "trunc keeps the low bits", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "trunc", "w": 32, "a": {"e": "const", "v": 4294967301, "w": 64}},
        "b": {"e": "const", "v": 5, "w": 32}}},
      {"op": "assert", "msg": "sext of i1 true is -1", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "ext", "signed": true, "w": 32, "a": {"e": "const", "v": 1, "w": 1}},
        "b": {"e": "const", "v": -1, "w": 32}}},
      {"op": "assert", "msg": "zext of i1 true is 1", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "ext", "signed": false, "w": 32, "a": {"e": "const", "v": 1, "w": 1}},
        "b": {"e": "const", "v": 1, "w": 32}}},
      {"op": "assert", "msg": "sext i32 -> i64", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "ext", "signed": true, "w": 64, "a": {"e": "const", "v": -5, "w": 32}},
        "b": {"e": "const", "v": -5, "w": 64}}},
      {"op": "assert", "msg": "ult compares unsigned", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "select", "w": 32,
              "c": {"e": "cmp", "o": "ult", "w": 1, "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 5, "w": 32}},
              "a": {"e": "const", "v": 10, "w": 32}, "b": {"e": "const", "v": 20, "w": 32}},
        "b": {"e": "const", "v": 20, "w": 32}}},
      {"op": "assert", "msg": "slt compares signed", "cond": {"e": "cmp", "o": "slt", "w": 1,
        "a": {"e": "const", "v": -1, "w": 32}, "b": {"e": "const", "v": 5, "w": 32}}},
      {"op": "assert", "msg": "unsigned literal spelling", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "const", "v": 4294967295, "w": 32}, "b": {"e": "const", "v": -1, "w": 32}}},
      {"op": "let", "var": "i", "expr": {"e": "const", "v": 0, "w": 32}},
      {"op": "while", "max_iters": 10, "loc": "eval_semantics.py:30",
       "cond": {"e": "cmp", "o": "slt", "w": 1, "a": {"e": "var", "name": "i", "w": 32}, "b": {"e": "var", "name": "X", "w": 32}},
       "body": [
        {"op": "let", "var": "i", "expr": {"e": "bin", "o": "add", "w": 32, "a": {"e": "var", "name": "i", "w": 32}, "b": {"e": "const", "v": 1, "w": 32}}}
       ]},
      {"op": "assert", "msg": "while runs until its condition fails", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "var", "name": "i", "w": 32}, "b": {"e": "var", "name": "X", "w": 32}}},
      {"op": "let", "var": "c", "expr": {"e": "const", "v": 0, "w": 32}},
      {"op": "for", "var": "j", "lb": {"e": "const", "v": 1, "w": 32}, "ub": {"e": "const", "v": 10, "w": 32}, "step": {"e": "const", "v": 3, "w": 32},
       "body": [
        {"op": "let", "var": "c", "expr": {"e": "bin", "o": "add", "w": 32, "a": {"e": "var", "name": "c", "w": 32}, "b": {"e": "var", "name": "j", "w": 32}}}
       ]},
      {"op": "assert", "msg": "for 1..10 step 3 visits 1, 4, 7", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "var", "name": "c", "w": 32}, "b": {"e": "const", "v": 12, "w": 32}}},
      {"op": "let", "var": "d", "expr": {"e": "const", "v": 0, "w": 32}},
      {"op": "for", "var": "j", "lb": {"e": "const", "v": -2, "w": 32}, "ub": {"e": "const", "v": 1, "w": 32}, "step": {"e": "const", "v": 1, "w": 32},
       "body": [
        {"op": "let", "var": "d", "expr": {"e": "bin", "o": "add", "w": 32, "a": {"e": "var", "name": "d", "w": 32}, "b": {"e": "var", "name": "j", "w": 32}}}
       ]},
      {"op": "assert", "msg": "for bounds are signed", "cond": {"e": "cmp", "o": "eq", "w": 1,
        "a": {"e": "var", "name": "d", "w": 32}, "b": {"e": "const", "v": -3, "w": 32}}},
      {"op": "for", "var": "j", "lb": {"e": "const", "v": 5, "w": 32}, "ub": {"e": "const", "v": 5, "w": 32}, "step": {"e": "const", "v": 1, "w": 32},
       "body": [
        {"op": "assert", "msg": "empty for range runs zero times", "cond": {"e": "const", "v": 0, "w": 1}}
       ]}
    ]}
  ],
  "case": {"name": "semantics", "inputs": [
    {"name": "x3", "params": {"X": 3}},
    {"name": "x0", "params": {"X": 0}}
  ]}
}
